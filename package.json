    "@tabler/icons-vue": "^3.52.0",
    "nuxt": "^4.6.4",
    "thumbhash": "^0.1.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "devDependencies": {
    "@carboneio/image-size": "^3.0.1",
    "@iconify-json/lucide": "^1.2.155",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "yaml": "^2.9.1"
  }
