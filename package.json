    "dev": "bun run photos:metadata && bun --bun run nuxt dev"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/hints": "^1.1.5",
    "@nuxt/test-utils": "^4.4.0",
