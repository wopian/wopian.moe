{
  "name": "wopian-moe",
  "private": true,
  "type": "module",
  "scripts": {
    "photos:metadata": "bun scripts/generate-photo-dimensions.ts",
    "generate": "bun run photos:metadata && bun --bun run nuxt generate",
    "typecheck": "bun --bun run nuxt typecheck",
    "test": "bun test",
    "preview": "bun scripts/serve-static.ts",
